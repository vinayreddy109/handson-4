def merge_two_sorted_arrays(arr1, arr2):
    result = []
    i, j = 0, 0
    while i < len(arr1) and j < len(arr2):
        if arr1[i] < arr2[j]:
            result.append(arr1[i])
            i += 1
        else:
            result.append(arr2[j])
            j += 1
    while i < len(arr1):
        result.append(arr1[i])
        i += 1
    while j < len(arr2):
        result.append(arr2[j])
        j += 1
    return result

def merge_k_sorted_arrays(arrays):
    if not arrays:
        return []
    while len(arrays) > 1:
        merged_arrays = []
        for i in range(0, len(arrays), 2):
            if i + 1 < len(arrays):
                merged = merge_two_sorted_arrays(arrays[i], arrays[i + 1])
            else:
                merged = arrays[i]
            merged_arrays.append(merged)
        arrays = merged_arrays
    return arrays[0]


